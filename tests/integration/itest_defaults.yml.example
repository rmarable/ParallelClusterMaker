---
################################################################################
# itest_defaults.yml.example
# Minimal defaults for the integration smoke test.
# Copy to itest_defaults.yml, fill in your vpc_name and subnets, then pass
# with --defaults to run_integration_test.sh.
#
# DO NOT commit your copy — it contains account-specific network values.
################################################################################

# --- Cluster identity ---
cluster_owner_department: hpc
cluster_type: ondemand             # ondemand avoids spot-capacity failures
prod_level: dev

# --- Instances ---
# Use x86_64 types with a matching x86 OS for broadest availability.
# For Graviton smoke tests change base_os to ubuntu2404arm and instance types
# to c8g.xlarge / c8g.2xlarge (or similar Graviton types).
base_os: ubuntu2404
headnode_instance_type: c5.xlarge
## CPU queue: comma-separated list; leave empty for GPU-only clusters
compute_instance_type: c5.xlarge
## GPU queue: comma-separated list; leave empty for CPU-only clusters (default)
gpu_instance_type:
headnode_root_volume_size: 50
headnode_root_volume_type: gp3
headnode_root_volume_iops: 3000
headnode_root_volume_throughput: 125
compute_root_volume_size: 50
compute_root_volume_type: gp3
compute_root_volume_iops: 3000
compute_root_volume_throughput: 125
gpu_root_volume_size: 250
gpu_root_volume_type: gp3
gpu_root_volume_iops: 3000
gpu_root_volume_throughput: 125

# --- Autoscaling ---
initial_cpu_queue_size: 2
max_cpu_queue_size: 2
maintain_cpu_initial_size: "true"
initial_gpu_queue_size: 2
max_gpu_queue_size: 2
maintain_gpu_initial_size: "false"
scaledown_idletime: 5

# --- Networking ---
# Fill these in for your account and target AZ.
# vpc_name must match the Name tag on your VPC.
# Leave headnode_subnet_id and compute_subnet_ids empty to auto-discover,
# or set them explicitly for deterministic results.
vpc_name: "FILL_IN_YOUR_VPC_NAME"
headnode_subnet_id: ""
compute_subnet_ids: ""
use_private_compute_subnet: "false"

# --- Storage (all disabled for smoke test) ---
ebs_shared_volume_size: 50
enable_efs: "false"
enable_fsx: "false"

# --- Optional features (all disabled for smoke test) ---
enable_efa: "false"
enable_external_nfs: "false"
enable_hpc_benchmarks: "false"
enable_monitoring: "false"
