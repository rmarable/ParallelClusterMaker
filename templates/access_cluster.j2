#!/bin/bash
# Generated by ParallelClusterMaker
# SSH access wrapper for {{ cluster_name }}
set -euo pipefail
SSH_KEYPAIR="{{ ssh_keypair }}"
EC2_USER="{{ ec2_user }}"
RETRIEVE_SCRIPT="$(dirname "$0")/retrieve_ssh_key.{{ cluster_name }}.sh"

# NODE_TYPE is chosen by access_cluster.py's -L/-H handling and passed via the
# ACCESS_NODE_TYPE environment variable -- always one of the two fixed
# literals "HeadNode"/"LoginNode" chosen by Python control flow, never
# interpolated from cluster-provided or file-derived text, so there is no
# injection surface here.
NODE_TYPE="${ACCESS_NODE_TYPE:-HeadNode}"
if [[ "$NODE_TYPE" == "LoginNode" ]]; then
    NODE_LABEL="login node"
else
    NODE_LABEL="head node"
fi

# An AWS call that FAILS and a cluster that is not running are different
# problems with different fixes, and 2>/dev/null || true made them look
# identical: expired credentials or an unset AWS_PROFILE reported "Is the
# cluster running?" against a healthy cluster, which sends the operator to the
# wrong place entirely.  A missing instance answers "None" with rc=0; an auth
# or API failure is a non-zero rc with a message on stderr.  Keep both.
# Named "_describe_node" rather than "_describe_head_node" because it now
# resolves login nodes too -- grafana_tunnel.j2's identically-named copy stays
# unrenamed, since it only ever resolves the head node.
_describe_node() {
    aws ec2 describe-instances \
        --region "{{ region }}" \
        --filters "Name=tag:parallelcluster:cluster-name,Values={{ cluster_name }}" \
                  "Name=tag:parallelcluster:node-type,Values=${NODE_TYPE}" \
                  "Name=instance-state-name,Values=running" \
        --query "Reservations[0].Instances[0].$1" \
        --output text 2>"$2"
}

AWS_STDERR="$(mktemp)"
trap 'rm -f "${AWS_STDERR}"' EXIT

_AWS_RC=0
HEAD_NODE_IP="$(_describe_node PublicIpAddress "${AWS_STDERR}")" || _AWS_RC=$?

if [[ "$_AWS_RC" -eq 0 && ( -z "$HEAD_NODE_IP" || "$HEAD_NODE_IP" == "None" ) ]]; then
    HEAD_NODE_IP="$(_describe_node PrivateIpAddress "${AWS_STDERR}")" || _AWS_RC=$?
fi

if [[ "$_AWS_RC" -ne 0 ]]; then
    echo "ERROR: The AWS API call failed (exit ${_AWS_RC}) while looking up the ${NODE_LABEL} -- this is NOT a cluster problem." >&2
    echo "  aws ec2 describe-instances said:" >&2
    sed 's/^/    /' "${AWS_STDERR}" >&2
    echo "  Check your credentials and region:" >&2
    echo "    aws sts get-caller-identity --region {{ region }}" >&2
    echo "  AWS_PROFILE is currently ${AWS_PROFILE:-<unset>}." >&2
    exit 1
fi

if [[ -z "$HEAD_NODE_IP" || "$HEAD_NODE_IP" == "None" ]]; then
    echo "ERROR: No running ${NODE_LABEL} found for {{ cluster_name }} in {{ region }}." >&2
    echo "  The AWS call succeeded, so the cluster is stopped, deleted, or in another region." >&2
    echo "  Check with: ./list_pcluster.py --live" >&2
    exit 1
fi

# Explicit, not left to the trap: this script ends in `exec ssh`, which replaces
# the process image, and an EXIT trap does not run on exec (verified under bash
# 5.3).  Without this the happy path leaks one file per connection, and this is
# a script an operator runs dozens of times a day.  The trap stays for the exits
# above.
rm -f "${AWS_STDERR}"

if [[ ! -f "$SSH_KEYPAIR" ]]; then
    echo "Local key not found — retrieving from Secrets Manager..."
    bash "${RETRIEVE_SCRIPT}" --out "${SSH_KEYPAIR}"
fi

echo "Connecting to ${NODE_LABEL} of {{ cluster_name }} at ${HEAD_NODE_IP}..."
exec ssh -i "${SSH_KEYPAIR}" -o StrictHostKeyChecking=accept-new "${EC2_USER}@${HEAD_NODE_IP}" "$@"
