{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "MCPEC2Read",
            "Action": [
                "ec2:Describe*"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Sid": "MCPEC2FleetLifecycle",
            "Action": [
                "ec2:RunInstances",
                "ec2:CreateFleet",
                "ec2:TerminateInstances",
                "ec2:CreateTags",
                "ec2:DeleteTags"
            ],
            "Effect": "Allow",
            "Resource": "*"
        },
        {
            "Sid": "MCPCloudFormationDescribeOnly",
            "Action": [
                "cloudformation:DescribeStacks"
            ],
            "Effect": "Allow",
            "Resource": "*"
        }
    ]
}
