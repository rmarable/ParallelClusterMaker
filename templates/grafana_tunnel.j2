#!/bin/bash
# Generated by ParallelClusterMaker
# Grafana SSH tunnel for {{ cluster_name }}
set -euo pipefail

CLUSTER_NAME="{{ cluster_name }}"
REGION="{{ region }}"
SSH_KEYPAIR="{{ ssh_keypair }}"
EC2_USER="{{ ec2_user }}"
LOCAL_PORT="${1:-8443}"
PID_FILE="/tmp/grafana-tunnel-${CLUSTER_NAME}.pid"

case "${2:-start}" in
  stop)
    if [[ -f "$PID_FILE" ]]; then
      kill "$(cat "$PID_FILE")" 2>/dev/null && echo "Grafana tunnel for ${CLUSTER_NAME} stopped." || true
      rm -f "$PID_FILE"
    else
      echo "No tunnel PID file found for ${CLUSTER_NAME}."
    fi
    exit 0
    ;;
esac

# A failed AWS call and a stopped cluster are different problems; see the same
# comment in access_cluster.j2.  2>/dev/null || true reported "Is the cluster
# running?" for expired credentials against a perfectly healthy cluster.
_describe_head_node() {
    aws ec2 describe-instances \
        --region "$REGION" \
        --filters "Name=tag:parallelcluster:cluster-name,Values=${CLUSTER_NAME}" \
                  "Name=tag:parallelcluster:node-type,Values=HeadNode" \
                  "Name=instance-state-name,Values=running" \
        --query "Reservations[0].Instances[0].$1" \
        --output text 2>"$2"
}

AWS_STDERR="$(mktemp)"
trap 'rm -f "${AWS_STDERR}"' EXIT

_AWS_RC=0
HEAD_NODE_IP="$(_describe_head_node PublicIpAddress "${AWS_STDERR}")" || _AWS_RC=$?

if [[ "$_AWS_RC" -eq 0 && ( -z "$HEAD_NODE_IP" || "$HEAD_NODE_IP" == "None" ) ]]; then
  HEAD_NODE_IP="$(_describe_head_node PrivateIpAddress "${AWS_STDERR}")" || _AWS_RC=$?
fi

if [[ "$_AWS_RC" -ne 0 ]]; then
  echo "ERROR: The AWS API call failed (exit ${_AWS_RC}) -- this is NOT a cluster problem." >&2
  echo "  aws ec2 describe-instances said:" >&2
  sed 's/^/    /' "${AWS_STDERR}" >&2
  echo "  Check your credentials and region:" >&2
  echo "    aws sts get-caller-identity --region ${REGION}" >&2
  echo "  AWS_PROFILE is currently ${AWS_PROFILE:-<unset>}." >&2
  exit 1
fi

if [[ -z "$HEAD_NODE_IP" || "$HEAD_NODE_IP" == "None" ]]; then
  echo "ERROR: No running head node found for ${CLUSTER_NAME} in ${REGION}." >&2
  echo "  The AWS call succeeded, so the cluster is stopped, deleted, or in another region." >&2
  echo "  Check with: ./list_pcluster.py --live" >&2
  exit 1
fi

# SSM addresses an instance ID, ssh an address. Same helper, same rc
# discipline; a failure is not fatal because the direct path below does
# not need it.
INSTANCE_ID="$(_describe_head_node InstanceId "${AWS_STDERR}")" || true

if [[ -f "$SSH_KEYPAIR" ]]; then
  :
else
  RETRIEVE_SCRIPT="$(dirname "$0")/retrieve_ssh_key.${CLUSTER_NAME}.sh"
  echo "Local key not found — retrieving from Secrets Manager..."
  bash "${RETRIEVE_SCRIPT}" --out "${SSH_KEYPAIR}"
fi

# Session Manager carries the tunnel when it can, so this needs no inbound
# port 22 and no public IP. Still `ssh -L` rather than SSM's own
# AWS-StartPortForwardingSession: the -L semantics, the -fN backgrounding
# and the PID-file lifecycle below are all unchanged this way, and the
# only difference is how the connection is routed.
SSH_TARGET="${EC2_USER}@${HEAD_NODE_IP}"
PROXY_ARGS=()
if [[ -n "${INSTANCE_ID:-}" && "${INSTANCE_ID}" != "None" ]] \
   && command -v session-manager-plugin >/dev/null 2>&1; then
  SSH_TARGET="${EC2_USER}@${INSTANCE_ID}"
  PROXY_ARGS=(-o "ProxyCommand=aws ssm start-session --target %h --document-name AWS-StartSSHSession --parameters portNumber=%p --region {{ region }}")
  echo "Tunnelling via SSM (${INSTANCE_ID})..."
elif ! command -v session-manager-plugin >/dev/null 2>&1; then
  echo "WARNING: session-manager-plugin not found -- tunnelling over direct SSH." >&2
  echo "  That needs inbound port 22 and a reachable address. To use SSM instead:" >&2
  echo "    brew install --cask session-manager-plugin" >&2
fi

# ${PROXY_ARGS[@]+...} guards the empty-array case: under `set -u` an
# empty array expansion is an unbound variable on bash before 4.4, and
# this script has no control over which bash an operator runs it with.
ssh -i "$SSH_KEYPAIR" \
    ${PROXY_ARGS[@]+"${PROXY_ARGS[@]}"} \
    -L "${LOCAL_PORT}:localhost:443" \
    -o StrictHostKeyChecking=accept-new \
    -o ExitOnForwardFailure=yes \
    -fN \
    "${SSH_TARGET}"

# Capture the PID of the backgrounded ssh process. Matched on whichever
# target was actually used -- an instance ID over SSM, an address
# otherwise -- since pgrep sees the real command line.
SSH_PID=$(pgrep -n -f "ssh.*${LOCAL_PORT}:localhost:443.*${SSH_TARGET##*@}" 2>/dev/null || true)
[[ -n "$SSH_PID" ]] && echo "$SSH_PID" > "$PID_FILE"

echo ""
echo "Grafana tunnel open for ${CLUSTER_NAME}."
echo "  URL:  https://localhost:${LOCAL_PORT}/grafana/"
echo "  Stop: $(basename "$0") ${LOCAL_PORT} stop"
echo ""
echo "Admin password:"
echo "  aws ssm get-parameter \\"
echo "    --region ${REGION} \\"
echo "    --name /parallelcluster/${CLUSTER_NAME}/grafana/admin-password \\"
echo "    --with-decryption --query Parameter.Value --output text"
echo ""
echo "Accept the self-signed certificate warning in your browser."
