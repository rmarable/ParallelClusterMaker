{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ClusterAlertTopicLifecycle",
            "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:GetTopicAttributes",
                "sns:SetTopicAttributes",
                "sns:Subscribe",
                "sns:Unsubscribe",
                "sns:ListSubscriptionsByTopic",
                "sns:Publish",
                "sns:TagResource"
            ],
            "Resource": "arn:aws:sns:*:<AWS_ACCOUNT_ID>:sns_alerts_*",
            "Effect": "Allow"
        },
        {
            "Sid": "ListTopicsIsUnscopable",
            "Action": [
                "sns:ListTopics"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Sid": "ClusterKeypairLifecycle",
            "Action": [
                "ec2:CreateKeyPair",
                "ec2:ImportKeyPair",
                "ec2:DeleteKeyPair",
                "ec2:DescribeKeyPairs"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Sid": "PerBuildBucketLifecycle",
            "Action": [
                "s3:CreateBucket",
                "s3:DeleteBucket",
                "s3:PutBucketVersioning",
                "s3:PutEncryptionConfiguration",
                "s3:PutBucketPublicAccessBlock",
                "s3:PutBucketTagging",
                "s3:GetBucketLocation",
                "s3:ListBucket",
                "s3:ListBucketVersions"
            ],
            "Resource": "arn:aws:s3:::parallelclustermaker-*",
            "Effect": "Allow"
        },
        {
            "Sid": "PerBuildBucketObjects",
            "Action": [
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:DeleteObjectVersion"
            ],
            "Resource": "arn:aws:s3:::parallelclustermaker-*/*",
            "Effect": "Allow"
        },
        {
            "Sid": "PclusterOwnRoleLifecycle",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:PutRolePolicy",
                "iam:GetRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListRolePolicies",
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:PassRole"
            ],
            "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/parallelcluster/*",
            "Effect": "Allow"
        },
        {
            "Sid": "GrafanaPasswordParameter",
            "Action": [
                "ssm:PutParameter",
                "ssm:GetParameter",
                "ssm:DeleteParameter",
                "ssm:AddTagsToResource"
            ],
            "Resource": "arn:aws:ssm:*:<AWS_ACCOUNT_ID>:parameter/parallelcluster/*",
            "Effect": "Allow"
        },
        {
            "Sid": "ResolveOwnIdentity",
            "Action": [
                "sts:GetCallerIdentity"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Sid": "ClusterPrivateDns",
            "Action": [
                "route53:ListHostedZones",
                "route53:AssociateVPCWithHostedZone"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Sid": "TheSshKeySecret",
            "Action": [
                "secretsmanager:CreateSecret",
                "secretsmanager:PutSecretValue",
                "secretsmanager:GetSecretValue",
                "secretsmanager:DeleteSecret",
                "secretsmanager:DescribeSecret",
                "secretsmanager:TagResource"
            ],
            "Resource": "arn:aws:secretsmanager:*:<AWS_ACCOUNT_ID>:secret:parallelcluster/*",
            "Effect": "Allow"
        },
        {
            "Sid": "IAMSpotServiceLinkedRole",
            "Effect": "Allow",
            "Action": [
                "iam:GetRole",
                "iam:CreateServiceLinkedRole"
            ],
            "Resource": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/aws-service-role/spot.amazonaws.com/AWSServiceRoleForEC2Spot"
        },
        {
            "Sid": "IAMManagedPolicyLifecycle",
            "Action": [
                "iam:CreatePolicy",
                "iam:DeletePolicy",
                "iam:GetPolicy",
                "iam:GetPolicyVersion",
                "iam:ListPolicies",
                "iam:ListPolicyVersions",
                "iam:ListEntitiesForPolicy"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/pclustermaker-policy-*"
            ]
        },
        {
            "Sid": "IAMAttachDetachClusterPolicies",
            "Action": [
                "iam:AttachRolePolicy",
                "iam:DetachRolePolicy",
                "iam:ListAttachedRolePolicies"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/pclustermaker-role-*"
            ],
            "Condition": {
                "StringLike": {
                    "iam:PolicyARN": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/pclustermaker-policy-*"
                }
            }
        },
        {
            "Sid": "IAMRoleLifecycle",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:GetRole",
                "iam:PutRolePolicy",
                "iam:GetRolePolicy",
                "iam:DeleteRolePolicy",
                "iam:ListRolePolicies",
                "iam:ListInstanceProfilesForRole",
                "iam:TagRole",
                "iam:PassRole"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/pclustermaker-role-*"
            ]
        },
        {
            "Sid": "IAMClusterBoundaryBootstrapReadAndCreate",
            "Action": [
                "iam:CreatePolicy",
                "iam:GetPolicy",
                "iam:GetPolicyVersion",
                "iam:ListPolicyVersions"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/pclustermaker-cluster-boundary"
            ]
        },
        {
            "Sid": "IAMBoundClusterRoleOnly",
            "Action": [
                "iam:PutRolePermissionsBoundary"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/pclustermaker-role-*"
            ],
            "Condition": {
                "StringEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/pclustermaker-cluster-boundary"
                }
            }
        },
        {
            "Sid": "IAMDenyWeakeningTheClusterBoundary",
            "Action": [
                "iam:CreatePolicyVersion",
                "iam:SetDefaultPolicyVersion",
                "iam:DeletePolicyVersion",
                "iam:DeletePolicy",
                "iam:DeleteRolePermissionsBoundary"
            ],
            "Effect": "Deny",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:policy/pclustermaker-cluster-boundary",
                "arn:aws:iam::<AWS_ACCOUNT_ID>:role/pclustermaker-role-*"
            ]
        },
        {
            "Sid": "IAMInstanceProfile",
            "Action": [
                "iam:CreateInstanceProfile",
                "iam:GetInstanceProfile",
                "iam:DeleteInstanceProfile",
                "iam:AddRoleToInstanceProfile",
                "iam:RemoveRoleFromInstanceProfile"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:iam::<AWS_ACCOUNT_ID>:instance-profile/pclustermaker-role-*"
            ]
        }
    ]
}
