#!/bin/bash
set -euo pipefail
################################################################################
# Name:		postinstall.{{ cluster_name }}.sh
# Author:	Rodney Marable <rodney.marable@gmail.com>
# Created On:	April 20, 2019
# Last Changed:	June 26, 2019
# Deployed On:	{{ Deployed_On }}
# Purpose:	Perform postinstall tasks on cluster {{ cluster_name }}
################################################################################
#
# Source the local profile to ensure PATH works as expected.
# All three options are suspended, not just `set -u`. A profile fragment is
# written for an interactive shell and is under no obligation to survive any of
# them: an RPM-based /etc/profile exports $HISTCONTROL unconditionally, which is
# fatal under `set -u`, and AL2023's /etc/profile.d/debuginfod.sh runs
#   DEBUGINFOD_URLS=$(cat /dev/null "/etc/debuginfod"/*.urls 2>/dev/null | tr '\n' ' ')
# where /etc/debuginfod/ does not exist -- `cat` exits 1, `tr` exits 0, and
# `pipefail` promotes the failure to the assignment, killing the node. That is
# what failed the first alinux2023 build of this cluster, 690 ms in with no
# output. Ubuntu's own profile is clean, but a site can drop anything into
# /etc/profile.d, so the guard applies on every OS. Same guard as
# monitoring-post-install-wrapper.j2; do not remove it and do not narrow it
# back to `set +u`.

set +euo pipefail
source /etc/profile
set -euo pipefail

# Ship the log that actually says why a bootstrap failed.
#
# The CloudWatch agent is configured by PCluster to ship /var/log/cfn-init.log
# and not /var/log/cfn-init-cmd.log.  The first records *that* a step ran and
# its return code; the second holds everything the step printed -- this script,
# preinstall, the operator's own --pre_install_script/--post_install_script
# hooks, and chef.  Confirmed by reading both on a live node.  Without this, a
# failed node leaves a CloudWatch record saying a command exited non-zero and
# nothing at all about why, and the evidence dies with the instance.
#
# Appended to the agent's config rather than replacing it: that file is
# PCluster's, and rewriting it would silently drop whatever the next release
# ships.  `from_beginning` is set explicitly so the whole file is sent even
# though this runs late in the boot -- which is also why placing this early
# would buy nothing.
#
# Entirely best-effort.  This script runs under `set -euo pipefail`, where a
# non-zero exit fails the node's bootstrap and, on a compute node, feeds
# clustermgtd's relaunch loop toward the partition's ten-failure protected-mode
# threshold.  Losing a log must never be what costs a cluster, so every step
# here is guarded and the block is skipped whole if the agent is not where it
# was.

PCM_CW_AGENT_CFG="/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.d/file_amazon-cloudwatch-agent.json"
if [ -f "$PCM_CW_AGENT_CFG" ]
then
	sudo python3 - "$PCM_CW_AGENT_CFG" <<'PCM_CW_EOF' 2>/dev/null || echo "WARNING: could not add cfn-init-cmd.log to the CloudWatch agent"
import json, sys

cfg = sys.argv[1]
want = "/var/log/cfn-init-cmd.log"
try:
    d = json.load(open(cfg))
    cl = d["logs"]["logs_collected"]["files"]["collect_list"]
except Exception:
    sys.exit(0)
if not cl or any(e.get("file_path") == want for e in cl):
    sys.exit(0)
# Modelled on an entry the agent already accepts, changing only the two
# fields that must differ. Adding a key it does not accept fails schema
# validation for the WHOLE config, and the agent then crash-loops shipping
# nothing at all -- which is what `from_beginning` did here: it is not in
# this agent's schema, and asserting otherwise from memory cost every log
# stream on the node. A new file is read from the start by default, so it
# bought nothing even had it been valid.
entry = dict(cl[0])
entry["file_path"] = want
entry["log_stream_name"] = "{instance_id}.cfn-init-cmd"
cl.append(entry)
json.dump(d, open(cfg, "w"))
PCM_CW_EOF
	sudo systemctl restart amazon-cloudwatch-agent >/dev/null 2>&1 		|| echo "WARNING: could not restart the CloudWatch agent"
fi

# Set values for some important variables. 

EC2_HOME="{{ ec2_user_home }}"
SRC="{{ ec2_user_src }}"

# This script is registered as OnNodeConfigured on the head node, on every
# compute queue, and on the login node pool, so every block below must be
# explicit about where it runs.
#
# The node type comes from /etc/parallelcluster/cfnconfig, which the
# aws-parallelcluster-environment::cfnconfig_mixed recipe writes during the init
# phase -- before any custom action runs -- as cfn_node_type=HeadNode,
# cfn_node_type=ComputeFleet, or cfn_node_type=LoginNode.  There is NO
# PARALLELCLUSTER_NODE_TYPE environment variable: custom_action_executor.py
# builds the child environment from
# os.environ plus the cfn_<event> script variables, and fetch_and_run keeps its
# own PCLUSTER_NODE_TYPE as an unexported shell variable.  Reading a nonexistent
# variable through `${...:-HeadNode}` is what made every compute node on cluster
# osiris run the entire head-node path on 2026-07-27: ten g4dn.xlarge instances
# cloned Lmod into shared NFS and pulled the toolkit down from S3, the gpu queue
# tripped protected mode, and the stack failed 82 minutes in.  The default was
# not a safety net -- it converted "the variable does not exist" into "be a head
# node" and kept the `*)` arm below from ever firing.
#
# An absent cfnconfig means this is not a ParallelCluster node -- an operator
# re-running the script by hand -- so HeadNode is the right default there.  A
# cfnconfig that exists without cfn_node_type is a changed upstream contract and
# must abort rather than silently pick a side.

NODE_TYPE="HeadNode"
if [ -f /etc/parallelcluster/cfnconfig ]
then
	# shellcheck disable=SC1091
	source /etc/parallelcluster/cfnconfig
	NODE_TYPE="${cfn_node_type-}"
	if [ -z "$NODE_TYPE" ]
	then
		echo "ERROR: /etc/parallelcluster/cfnconfig defines no cfn_node_type"
		exit 1
	fi
fi

# Configure a local_scratch directory and set the sticky bit if instance
# store volumes are not being used: https://en.wikipedia.org/wiki/Sticky_bit

if [ ! -d /scratch ]
then
	sudo mkdir -p /local_scratch
	sudo chmod 1777 /local_scratch
	ln -sfn /local_scratch /scratch
else
	ln -sfn /scratch /local_scratch
fi

{% if enable_gpu == 'true' %}
# Mount NVMe instance store at /local_scratch if present; fall back to the
# sticky-bit directory already created above for instances without instance store.
#
# Three filters, all load-bearing.  The model check is what keeps EBS volumes --
# which also enumerate as /dev/nvme* -- from being reformatted.  The holders and
# blkid checks keep us off devices ParallelCluster's own cookbook already claimed:
# aws-parallelcluster-environment::ephemeral_drives runs BEFORE OnNodeConfigured,
# and on any instance type with instance store it puts every such device into an
# LVM physical volume (/dev/vg.01/lv_ephemeral), formats it ext4, and mounts it on
# /scratch.  mkfs.xfs then fails with "cannot open /dev/nvme1n1: Device or resource
# busy", and under `set -euo pipefail` that is a failed compute node -- which
# clustermgtd retries until the partition trips protected mode and the whole stack
# fails.  That is exactly what happened to osiris's gpu queue on 2026-07-27
# (g4dn.xlarge, one instance-store device, 8 bootstrap failures before teardown).
# This block was unreachable until session 22 made postinstall run on compute
# nodes; instance store exists only there, so no earlier build could expose it.
#
# On a single-device instance type the practical result is that this block now
# no-ops and /local_scratch is the symlink to PCluster's own /scratch made above.
# It still fires on devices PCluster left alone.  Do not "simplify" either check
# away: holders alone misses a formatted-but-unmounted device, and blkid alone
# misses a device claimed with no filesystem signature of its own.
#
# LoginNode is excluded: an interactive login node's local NVMe storage has
# nothing to do with the GPU queue, and this block would otherwise silently
# claim and reformat it whenever enable_gpu is true cluster-wide, regardless
# of loginnode_instance_type.

if [ "$NODE_TYPE" != "LoginNode" ]
then

_GPU_SCRATCH=/local_scratch
mapfile -t _NVME_DEVS < <(
    find /sys/block -maxdepth 1 -name 'nvme*' | while read -r _b; do
        # One if rather than three `[[ ... ]] && continue` guards.  This is style,
        # not correctness: both forms were run under bash 5.3 against the same
        # fake sysfs and emit the same devices with status 0, in every position
        # (`continue` inside a loop body is exempt from `set -e`).  The single
        # condition is kept because the three tests are one decision.
        _model=$(cat "$_b/device/model" 2>/dev/null | tr -d ' ')
        _dev="/dev/$(basename "$_b")"
        if [[ "$_model" == "AmazonEC2NVMeInstanceStorage" ]] &&
           [[ -z "$(ls -A "$_b/holders" 2>/dev/null)" ]] &&
           ! sudo blkid "$_dev" > /dev/null 2>&1
        then
            basename "$_b"
        fi
    done | sort
)
_NVME_COUNT=$(echo "${_NVME_DEVS[*]}" | wc -w | tr -d ' ')

if [[ $_NVME_COUNT -eq 1 ]]; then
    _DEV="/dev/${_NVME_DEVS[0]}"
    sudo mkfs.xfs -f "$_DEV"
    sudo mount -o noatime,nodiratime "$_DEV" "$_GPU_SCRATCH"
    echo "$_DEV $_GPU_SCRATCH xfs noatime,nodiratime,nofail 0 0" | sudo tee -a /etc/fstab > /dev/null
    sudo chmod 1777 "$_GPU_SCRATCH"
elif [[ $_NVME_COUNT -gt 1 ]]; then
    _RAID_DEVS=("${_NVME_DEVS[@]/#//dev/}")
    sudo mdadm --create /dev/md0 --level=0 --raid-devices="$_NVME_COUNT" "${_RAID_DEVS[@]}" --force
    sudo mkfs.xfs -f /dev/md0
    sudo mount -o noatime,nodiratime /dev/md0 "$_GPU_SCRATCH"
    echo "/dev/md0 $_GPU_SCRATCH xfs noatime,nodiratime,nofail 0 0" | sudo tee -a /etc/fstab > /dev/null
    sudo chmod 1777 "$_GPU_SCRATCH"
fi

fi

# Install monitoring tools.  Installed here rather than relying on the
# head-node-only package block below, which compute nodes never reach.
#
# A compute node must refresh its package index first.  OnNodeStart -- and
# therefore preinstall.j2's index refresh -- is registered on the head node only,
# so a compute node's /var/lib/apt/lists (or dnf cache) is whatever the AMI
# shipped.  With no Packages file for the release, `apt-get -y install nvtop`
# exits 100 with "E: Unable to locate package nvtop"; that failed osiris's gpu
# queue at 17:42 on 2026-07-27, one line after the NVMe fix above let the node get
# this far.  The head node needs no refresh here: preinstall.j2 already did one,
# and the head-node package block below does another.
#
# nvtop is head-node-only where it is available at all.  It is outside the default
# repositories (multiverse on Ubuntu, EPEL on RHEL), the operator logs into the
# head node rather than a compute node, and it is the only such package on either
# path.  On AL2023 it is not installed anywhere: it is absent from the core repo
# on both arches, and there is no EPEL to reach for -- see that arm below.
#
# Both commands are non-fatal, which no other install in this file is.  A compute
# node that exits non-zero is not simply lost: clustermgtd relaunches it and
# counts it toward the partition's 10-failure protected-mode threshold, so one
# transient mirror outage would cost the whole stack.  Nothing in the toolkit's
# job path imports either package -- they are diagnostics.

{% if 'ubuntu' in base_os %}
if [ "$NODE_TYPE" == "HeadNode" ]
then
	sudo apt-get -y install nvtop htop || echo "WARNING: nvtop/htop unavailable on this node"
else
	sudo apt-get -y update || echo "WARNING: apt index refresh failed; htop may be unavailable"
	sudo apt-get -y install htop || echo "WARNING: htop unavailable on this node"
fi
{% elif 'alinux' in base_os %}
# Same node-type split for the same reasons, but htop only on both node types.
# nvtop is absent from the al2023 core repo on x86_64 and aarch64 alike, and
# there is no EPEL to fall back on: epel-release is not packaged for al2023, and
# the EPEL 9 release RPM is built for el9 -- so the RHEL arm's URL install must
# not be copied here.  Adding a repository nothing then installs from would be
# pure bootstrap latency plus a network dependency a private-subnet cluster has
# to satisfy.  Non-fatal for the same reason as the other two arms.
if [ "$NODE_TYPE" == "HeadNode" ]
then
	sudo dnf -y install htop || echo "WARNING: htop unavailable on this node"
else
	sudo dnf -y makecache || echo "WARNING: dnf metadata refresh failed; htop may be unavailable"
	sudo dnf -y install htop || echo "WARNING: htop unavailable on this node"
fi
{% else %}
# Same split for the same reasons.  nvtop is in EPEL, which is not in RHEL's own
# repositories -- it installs by URL rather than by name -- so the head node adds
# it here and the compute node installs only htop, which is in baseos.  Every
# command in this block is non-fatal for the reason above.
if [ "$NODE_TYPE" == "HeadNode" ]
then
	sudo dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm" || echo "WARNING: EPEL unavailable; nvtop will not install"
	sudo dnf -y install nvtop htop || echo "WARNING: nvtop/htop unavailable on this node"
else
	sudo dnf -y makecache || echo "WARNING: dnf metadata refresh failed; htop may be unavailable"
	sudo dnf -y install htop || echo "WARNING: htop unavailable on this node"
fi
{% endif %}
{% endif %}

if [ "$NODE_TYPE" == "HeadNode" ]
then

# Configure Spack:
# https://spack.io/
# Head node only: $SPACK_DIR lives on shared storage, so a recursive chown from
# every scaling compute node would be redundant and would race.

SPACK_DIR="{{ spack_root }}"
if [ ! -d "$SPACK_DIR" ]
then
	sudo mkdir -p "$SPACK_DIR"
fi
sudo chown -R "{{ ec2_user }}:{{ ec2_user }}" "$SPACK_DIR"
sudo chmod -R 755 "$SPACK_DIR"

{% if 'ubuntu' in base_os %}
# Install critical packages via apt-get.
#
# `bc` is here for Lmod's ./configure, which hard-quits on a missing bc with
# "You must have bc in your path. Quitting!" -- see the dnf arm below, where it
# was observed.  Nothing else in the toolkit calls bc.  It is on the Ubuntu arm
# too even though that AMI happens to ship it, because "the base image happens to
# carry it" is not a property worth depending on across image bumps.
# Bound and retry every fetch, for the reason preinstall.j2 documents at
# length: an unbounded apt hangs the node, and a bare one dies on a
# transient mirror error.  These packages are genuinely required -- Lmod
# will not build without lua and bc -- so unlike preinstall's opportunistic
# upgrade they cannot be made non-fatal; retrying is the only correct
# answer.  Cluster stageb's third build died exactly here, on
# `503 Service Unavailable` from us-east-1.ec2.ports.ubuntu.com for
# liblua5.1-0, lua5.1, lua-socket, lua-sec and luarocks, after the same
# mirror had already taken two earlier builds down.  Retries=5 rather than
# preinstall's 3: this is the fatal path, and the extra attempts cost
# nothing when the mirror is healthy.
APT_TIMEOUTS="-o Acquire::Retries=5 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::ftp::Timeout=30"

sudo timeout 300 apt-get -y $APT_TIMEOUTS update || echo "WARNING: apt index refresh failed or timed out; installs will use the AMI's index"
sudo timeout 900 apt-get -y $APT_TIMEOUTS install gcc git lua5.4 liblua5.4-dev lua-filesystem nfs-common parallel pigz tcl tcsh zsh lua-posix tcllib binutils bc
{% elif 'alinux' in base_os %}
# Install critical packages via dnf.  Same kernel exclusions and the same `bc`
# requirement as the RHEL arm below -- read that comment for both.
#
# No EPEL and no CRB here, unlike RHEL: lua, lua-devel, lua-filesystem, lua-posix,
# lua-term, bc, tcl and every build tool on this line are all in the al2023 core
# repo on x86_64 and aarch64 (checked against the repo metadata, not assumed), so
# there is nothing left for a second repository to supply.  epel-release is not
# packaged for al2023 at all, so the RHEL arm's URL install has no analog.
#
# tcllib is deliberately NOT on this line: it is absent from the al2023 core repo,
# and nothing in this toolkit references it -- Lmod uses tcl itself.  Adding it
# back for symmetry with the other two arms would fail the node.
#
# lua-term is here because it comes from the core repo as an RPM rather than being
# built by luarocks; see the luarocks block below, which is a no-op on this arm.
sudo dnf -y --exclude='kernel*' --exclude='kmod-lustre*' --exclude='lustre-client*' --exclude='efa*' update
sudo dnf -y install gcc git lua lua-devel lua-filesystem lua-posix lua-term nfs-utils parallel pigz rpm-build tcl tcsh zsh binutils bc
{% else %}
# Install critical packages via dnf.
#
# The kernel is excluded here for the same two reasons as preinstall.j2: an
# unbounded dracut rebuild inside the bootstrap window, and PCluster's EFA and
# Lustre modules are built against the kernel the AMI boots.
#
# EPEL is required: lua-devel, lua-posix, lua-filesystem, and tcllib are not in
# RHEL 9's baseos or appstream repositories.  It installs by URL because
# epel-release itself is not packaged in RHEL, unlike CentOS and Amazon Linux.
#
# CodeReady Builder is enabled best-effort because its repository id is not the
# same everywhere: `crb` on Rocky, Alma, and CentOS Stream, and a longer
# codeready-builder-for-rhel-9-* id on genuine RHEL, whose exact spelling depends
# on whether the AMI is registered through RHUI or subscription-manager.  Rather
# than guess, try each and let the package install below be the arbiter -- it is
# fatal, so if any of these packages really needs CRB the node fails loudly with
# the missing package named instead of on an unrecognized repository id.
# `dnf config-manager` itself is a dnf-plugins-core subcommand and may be absent.
#
# `bc` is NOT on the RHEL 9 PCluster AMI (verified on head node i-0000000000000015)
# and Lmod's ./configure hard-quits without it: "You must have bc in your path.
# Quitting!", which under `set -euo pipefail` is OnNodeConfiguredExecutionFailure.
# That failed osiris at 17:26 on 2026-07-28, one stage after the pip fix let the
# node get this far.  It is in rhel-9-baseos, so it needs neither EPEL nor CRB.
# The only other tool ./configure can quit on is one of sha1sum|shasum|md5sum|md5,
# and sha1sum is present on both AMIs.

sudo dnf -y --exclude='kernel*' --exclude='kmod-lustre*' --exclude='lustre-client*' --exclude='efa*' update
sudo dnf -y install "https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm"
for _crb in crb codeready-builder-for-rhel-9-rhui-rpms "codeready-builder-for-rhel-9-$(uname -m)-rpms"
do
	sudo dnf -y config-manager --set-enabled "$_crb" 2>/dev/null && break
done || true
sudo dnf -y install gcc git lua lua-devel lua-filesystem nfs-utils parallel pigz rpm-build tcl tcsh zsh lua-posix tcllib binutils bc
{% endif %}

fi  # end HeadNode-only package and Spack directory block

# Create a local source directory for the {{ ec2_user }} user account.
# Head node only: $SRC is under {{ ec2_user_home }}, which ParallelCluster
# NFS-exports from the head node, and only the head-node blocks below build in it.

if [ "$NODE_TYPE" == "HeadNode" ] && [ ! -d "$SRC" ]
then
	sudo mkdir -p "$SRC"
	sudo chown -R "{{ ec2_user }}:{{ ec2_user }}" "$SRC"
	sudo chmod -R 755 "$SRC"
fi
{% if enable_external_nfs == 'true' %}

# Create directories and persistently mount all external NFS file systems 
# listed in the external_nfs_mount_list configuration file.

external_nfs_server="{{ external_nfs_server }}"
NFS_MOUNT_LIST=$(mktemp)
aws s3 cp "s3://{{ s3_bucketname }}/{{ s3_script_path }}/{{ external_nfs_mount_list_template_dest }}" "$NFS_MOUNT_LIST"
while IFS= read -r dir; do
	[[ -z "$dir" || "$dir" == \#* ]] && continue
	sudo mkdir -p "{{ external_nfs_server_root }}/$dir"
	sudo chown root:root "{{ external_nfs_server_root }}/$dir"
	sudo chmod -R 755 "{{ external_nfs_server_root }}/$dir"
	echo "${external_nfs_server}:${dir} {{ external_nfs_server_root }}/${dir} nfs defaults 0 0" | sudo tee -a /etc/fstab > /dev/null
	sudo mount "{{ external_nfs_server_root }}/$dir"
done < "$NFS_MOUNT_LIST"
rm -f "$NFS_MOUNT_LIST"
{% endif %}

# Create the Spack software package directory on the head node.
# Spack package installation location is controlled by the selected shared
# storage option.  Only one package location per cluster is supported.
# Precedence: FSX > EFS > external NFS > EBS

if [ "$NODE_TYPE" == "HeadNode" ]
then
	if [ ! -d "{{ pkg_dir }}" ]
	then
		sudo mkdir -p "{{ pkg_dir }}"
		sudo chown -R "{{ ec2_user }}:{{ ec2_user }}" "{{ pkg_dir }}"
		sudo chmod -R 755 "{{ pkg_dir }}"
	fi
fi

# Install luarocks and Lmod only on the head node — compute nodes mount /usr/local
# from shared storage and inherit the installation.

if [ "$NODE_TYPE" == "HeadNode" ]; then
{% if 'ubuntu' in base_os %}

# liblua5.1-0-dev is explicit because apt will not install it on its own.  Ubuntu's
# luarocks package declares an *alternative* dependency group -- liblua5.1-dev |
# liblua5.2-dev | liblua5.3-dev -- and apt satisfies it with 5.3, while the same
# package's parallel lua5.1|lua5.2|lua5.3 group leaves luarocks itself running
# lua_version 5.1.  luaposix, luafilesystem, and lua-term are C extensions that
# compile against lua.h for the version luarocks targets, so on a stock ubuntu2404
# AMI they find /usr/include/lua5.3 and /usr/include/lua5.4 but no lua5.1 header at
# all, and the build fails.  Under `set -euo pipefail` that failed osiris's head node
# with OnNodeConfiguredExecutionFailure -- and cfn-init records stdout only, so the
# compiler error went nowhere and the log's last line is the luarocks banner.
# LUA_VER below is read from the 5.1 interpreter, so the whole block is 5.1: do not
# "fix" this by switching the rocks to 5.3 without changing that too.
sudo timeout 600 apt-get install -y $APT_TIMEOUTS luarocks liblua5.1-0-dev
sudo luarocks install luaposix
sudo luarocks install luafilesystem
sudo luarocks install lua-term
{% elif 'alinux' in base_os %}
# No luarocks on this arm at all: it is absent from the al2023 core repo on both
# arches.  All three rocks the other two arms build are packaged as RPMs there
# instead -- lua-posix, lua-filesystem, and lua-term -- and were installed on the
# package line above, so there is nothing left to build.  The three
# `luarocks install` lines are therefore inside the other two arms rather than
# below the {% raw %}{% endif %}{% endraw %}: as unconditional lines they would run here as well, and
# `luarocks: command not found` under `set -euo pipefail` is a dead head node.
#
# LUA_CPATH and LUA_PATH below need no case for this.  The RPMs install to
# /usr/lib64/lua/5.4 and /usr/share/lua/5.4 (checked in the repo filelists on both
# arches) rather than under $LUAROCKS_PREFIX/lib/lua, but the trailing `;;` in both
# variables expands to the interpreter's own compiled-in default path, which covers
# lib64.  Do not add a lib64 branch.
{% else %}
# No separate header package is needed here.  The alternative-dependency-group
# problem above is Ubuntu packaging: RHEL's luarocks depends on lua-devel for the
# same lua it targets, and lua-devel was installed on the package line above.
# LUA_VER below is still read off the interpreter, so the block stays consistent
# with whatever version that is.
sudo dnf install -y luarocks
sudo luarocks install luaposix
sudo luarocks install luafilesystem
sudo luarocks install lua-term
{% endif %}

# Install and configure Lmod.

cd "$SRC"
git clone --depth=1 --branch 8.7.55 https://github.com/TACC/Lmod
cd Lmod
export PATH=/usr/local/bin:$PATH
export LUAROCKS_PREFIX=/usr
LUA_VER=$(lua -e 'print(_VERSION)' | awk '{print $2}')
export LUA_CPATH="$LUAROCKS_PREFIX/lib/lua/${LUA_VER}/?.so;;"
export LUA_PATH="$LUAROCKS_PREFIX/share/lua/${LUA_VER}/?.lua;$LUAROCKS_PREFIX/share/lua/${LUA_VER}/?/init.lua;;"
./configure --prefix=/usr/local --with-module-root-path="{{ pkg_dir }}/modulefiles" --with-spiderCacheDir="{{ pkg_dir }}/ModuleData/cachedir" --with-updateSystemFn="{{ pkg_dir }}/ModuleData/system.txt"
sudo -E make install
ln -sf /usr/local/lmod/lmod/libexec/lmod /usr/local/bin/lmod

# Copy the Lmod user login environment environment scripts to /etc/profile.d.
# Add $SPACK_DIR/bin to $PATH, set $SPACK_ROOT, and enable Spack shell support.

sudo cp /usr/local/lmod/lmod/init/sh /etc/profile.d/lmod.sh
cat << 'ENVEOF' >> /etc/profile.d/lmod_spack.sh
#!/bin/sh

export PATH="$PATH:{{ spack_root }}/bin"
export SPACK_ROOT="{{ spack_root }}"
source "{{ spack_root }}/share/spack/setup-env.sh"
ENVEOF

sudo cp /usr/local/lmod/lmod/init/csh /etc/profile.d/lmod.csh
cat << 'ENVEOF' >> /etc/profile.d/lmod_spack.csh
#!/bin/csh

setenv PATH "$PATH:{{ spack_root }}/bin"
setenv SPACK_ROOT "{{ spack_root }}"
source "{{ spack_root }}/share/spack/setup-env.csh"
ENVEOF

fi  # end HeadNode-only Lmod/luarocks block

# Install Spack on the cluster head node.
# Push an alert via SNS when new instances are spawned.
# Other custom role-specific tasks should be added here.

case "$NODE_TYPE" in
HeadNode)
	echo "Customize the pcluster stack head node here."
	echo "Ready to finish joining the cluster!"
{% if enable_hpc_benchmarks == 'true' %}

	# Deploy performance toolkit from S3 and install Python plotting dependencies.

	# Allowlist mirrors stage_and_upload_hpc_benchmark_driver.  This pull is the
	# self-repair copy only -- the driver, chmod'd below.  The personalized tree
	# (job script, README, and a second copy of the driver) is pulled separately
	# from the `performance/` prefix into
	# ~/hpc-benchmark/<cluster>/<owner>/slurm, further down in the staging
	# block; it used to arrive by scp, and this comment still said so.
	aws s3 sync "s3://{{ s3_bucketname }}/hpc-benchmark/" "{{ ec2_user_home }}/hpc-benchmark/" \
		--exclude "*" --include "hpc-benchmark.sh"
	chmod +x "{{ ec2_user_home }}/hpc-benchmark/hpc-benchmark.sh"
	# --ignore-installed on both arms: without it a resolver decision to replace a
	# distro-owned transitive dependency (RHEL 9 ships packaging, dateutil and
	# pyparsing as RPMs) reaches "Attempting uninstall" on a dist-info that has no
	# RECORD, which is what failed this cluster's head node in preinstall on
	# 2026-07-28.  The five names here are unpinned, so the direct requirements
	# are already satisfied by preinstall and would not be replaced -- the
	# exposure is one level down.  Cost is a re-download of five wheels on the
	# head node only, gated on enable_hpc_benchmarks; all five publish manylinux
	# aarch64 wheels, so this is not a from-source build on the arm images.
{% if 'ubuntu' in base_os %}
	pip3 install --quiet --ignore-installed --break-system-packages matplotlib numpy pandas scipy seaborn
{% else %}
	pip3 install --quiet --ignore-installed matplotlib numpy pandas scipy seaborn
{% endif %}
{% endif %}
	echo "Bootstrapping Spack..."
	cd "{{ pkg_dir }}"
	git clone --depth=1 --branch v0.23.0 https://github.com/spack/spack.git
	chown -R "{{ ec2_user }}:{{ ec2_user }}" "{{ pkg_dir }}"
{% if enable_fsx == 'true' and enable_fsx_hydration == 'true' %}

	# Create scripts in /usr/local/bin that will:
	# - import s3://{{ fsx_s3_import_bucket }}/{{ fsx_s3_import_path }} from Lustre
	# - export s3://{{ fsx_s3_export_bucket }}/{{ fsx_s3_export_path }} to Lustre
	# - check the status of an export-S3-to-Lustre process

	sudo su -c "echo \"nohup find {{ fsx_root }} -type f -print0 | xargs -0 -n 1 sudo lfs hsm_restore &\" > /usr/local/bin/import-s3-to-lustre.sh"
	sudo su -c "echo \"nohup find {{ fsx_root }} -type f -print0 | xargs -0 -n 1 sudo lfs hsm_archive &\" > /usr/local/bin/export-lustre-to-s3.sh"
	sudo su -c "echo \"find {{ fsx_root }} -type f -print0 | xargs -0 -n 1 -P 8 sudo lfs hsm_action | grep \\\"ARCHIVE\\\" | wc -l\" > /usr/local/bin/check-lustre-export-progress.sh"

	for script in /usr/local/bin/import-s3-to-lustre.sh /usr/local/bin/export-lustre-to-s3.sh /usr/local/bin/check-lustre-export-progress.sh
	do
		sudo chmod 0755 "$script"
		sudo chown root:root "$script"
	done
{% endif %}
	;;
ComputeFleet)
	echo "Customize the pcluster stack compute instances here."
	echo "Ready to finish joining the cluster!"
	;;
LoginNode)
	# Treated like ComputeFleet, not HeadNode: login nodes NFS-mount the same
	# shared /home the head node exports, and running the Spack/Lmod build
	# steps here would race the head node (and every other login node in the
	# pool) writing the same shared paths concurrently at boot.
	echo "Customize the pcluster stack login node here."
	echo "Ready to finish joining the cluster!"
	;;
*)
	# NODE_TYPE comes from cfn_node_type in /etc/parallelcluster/cfnconfig,
	# which ParallelCluster writes as HeadNode, ComputeFleet, or LoginNode. A
	# fourth value means the contract changed and node-type gating above
	# silently stopped applying.
	echo "ERROR: unrecognized cfn_node_type: $NODE_TYPE"
	exit 1
	;;
esac

# Create some local aliases for HPC operator convenience.  Prevent multiple
# copies of each alias from proliferating in the {{ ec2_user }} bash profile.
#
# Head node only. {{ ec2_user_home }} is NFS-exported from the head node, so
# every compute node appending here would be a concurrent read-modify-write on
# one file -- the grep guard does not make that safe -- and nobody logs into a
# compute node interactively anyway.

if [ "$NODE_TYPE" == "HeadNode" ]
then

# src
BASHRC="{{ ec2_user_home }}/.bashrc"
LINE_SRC="alias src='cd ~/src'"
grep -qF -- "$LINE_SRC" "$BASHRC" || echo "$LINE_SRC" >> "$BASHRC"

# ebs-pdir
LINE_EBS="alias ebsdir='cd \"{{ ebs_performance_dir }}\"'"
grep -qF -- "$LINE_EBS" "$BASHRC" || echo "$LINE_EBS" >> "$BASHRC"
{% if enable_efs == 'true' %}

# efs-pkgdir
LINE_EFS_PKGDIR="alias epkgdir='cd \"{{ efs_pkg_dir }}\"'"
grep -qF -- "$LINE_EFS_PKGDIR" "$BASHRC" || echo "$LINE_EFS_PKGDIR" >> "$BASHRC"
{% endif %}
{% if enable_efs == 'true' and enable_hpc_benchmarks == 'true' %}

# efs-pdir
LINE_EFS_PDIR="alias edir='cd \"{{ efs_hpc_performance_dir }}\"'"
grep -qF -- "$LINE_EFS_PDIR" "$BASHRC" || echo "$LINE_EFS_PDIR" >> "$BASHRC"
{% endif %}
{% if enable_fsx == 'true' %}

# fsx-pkgdir
LINE_FSX_PKGDIR="alias fpkgdir='cd \"{{ fsx_pkg_dir }}\"'"
grep -qF -- "$LINE_FSX_PKGDIR" "$BASHRC" || echo "$LINE_FSX_PKGDIR" >> "$BASHRC"
{% endif %}
{% if enable_fsx == 'true' and enable_hpc_benchmarks == 'true' %}

# fsx-pdir
LINE_FSX_PDIR="alias fdir='cd \"{{ fsx_hpc_performance_dir }}\"'"
grep -qF -- "$LINE_FSX_PDIR" "$BASHRC" || echo "$LINE_FSX_PDIR" >> "$BASHRC"
{% endif %}
{% if enable_external_nfs == 'true' %}

# nfs-pkgdir
LINE_EXTERNAL_NFS_PKGDIR="alias npkgdir='cd \"{{ external_nfs_pkg_dir }}\"'"
grep -qF -- "$LINE_EXTERNAL_NFS_PKGDIR" "$BASHRC" || echo "$LINE_EXTERNAL_NFS_PKGDIR" >> "$BASHRC"
{% endif %}
{% if enable_external_nfs == 'true' and enable_hpc_benchmarks == 'true' %}

# nfs-pdir
LINE_EXTERNAL_NFS_PDIR="alias ndir='cd \"{{ external_nfs_hpc_performance_dir }}\"'"
grep -qF -- "$LINE_EXTERNAL_NFS_PDIR" "$BASHRC" || echo "$LINE_EXTERNAL_NFS_PDIR" >> "$BASHRC"
{% endif %}

# Cleanup: remove the Lmod build tree, which only the head node created.

cd "$SRC"
for dir in Lmod luarocks-*
do
	rm -rf "$dir"
done

fi  # end HeadNode-only alias and cleanup block

# Drop the completion marker that check_pcluster.py and diagnose_pcluster.py
# look for. This is the last statement before exit: `set -e` at the top means
# any earlier failure aborts before the marker is written, so its presence
# means the whole script ran to completion.
#
# Head node only. /opt/parallelcluster/shared is NFS-exported from the head
# node, so a compute node writing here would either be denied by root-squash --
# aborting its own bootstrap under `set -e` -- or silently re-touch the head
# node's marker, making it mean "some node finished" instead of "the head node
# finished". Both consumers SSH to the head node and read only this path. A
# compute node that fails postinstall is already reported by ParallelCluster,
# which fails the node's bootstrap on a non-zero exit.

# Pull the staging tree the build published to S3 before this cluster was
# created.  It used to be scp'd in afterwards, which put the operator's own
# machine on the path: it needed the private key, a route to this node, and
# a public IP -- so it could not work into a private subnet, and it could
# not work at all from the MCP transport, where "the machine that built the
# cluster" is a Lambda with neither the key nor a route.  Pulling needs
# none of that.  The node already reads this bucket for preinstall,
# postinstall and the monitoring tarball, so this is a grant it has.
#
# Head node only: $HOME and the staging tree are NFS-exported from here, so
# every compute node pulling the same tree is a concurrent write to one
# path for no gain.
#
# Non-fatal, deliberately.  This script runs under `set -euo pipefail` and
# a non-zero exit fails the node's bootstrap -- for a compute node, into
# clustermgtd's relaunch loop and the partition's 10-failure protected-mode
# threshold.  The staging tree is convenience for the operator, not
# something the cluster needs to run, so a failed pull warns and the marker
# below is simply absent.  check_pcluster.py reports that absence; a node
# that died over it would report nothing at all.

if [ "$NODE_TYPE" == "HeadNode" ]
then
	_STAGE_DEST="{{ stage_dir }}"
	mkdir -p "$_STAGE_DEST"
	if aws s3 sync "s3://{{ s3_bucketname }}/staging/" "$_STAGE_DEST/" ; then
		if [ -f "$_STAGE_DEST/sbatch_default_submission_script.sh" ]; then
			cp "$_STAGE_DEST/sbatch_default_submission_script.sh" \
				"{{ ec2_user_home }}/sbatch_default_submission_script.sh"
			chmod +x "{{ ec2_user_home }}/sbatch_default_submission_script.sh"
		fi
{% if enable_hpc_benchmarks == 'true' %}
		mkdir -p "{{ headnode_performance_dir_dest }}"
		aws s3 sync "s3://{{ s3_bucketname }}/performance/" \
			"{{ headnode_performance_dir_dest }}/" \
			|| echo "WARNING: could not pull the performance tree from S3"
		# `aws s3 sync` does not carry file modes, and this block runs as
		# root -- so without these two lines the tree the build summary tells
		# the operator to use lands 644 root:root: `./hpc-benchmark.sh` is
		# not executable, and `install` cannot write its bin/ and
		# benchmark_results/ subdirectories. Confirmed on a live osiris
		# build. The self-repair copy 170 lines above and the sbatch script
		# three lines above both already chmod for the same reason; this one
		# was the only pull that did not.
		chmod +x "{{ headnode_performance_dir_dest }}/hpc-benchmark.sh" \
			2>/dev/null || echo "WARNING: could not chmod the benchmark driver"
		sudo chown -R "{{ ec2_user }}:{{ ec2_user }}" \
			"{{ ec2_user_home }}/hpc-benchmark" \
			|| echo "WARNING: could not chown the benchmark tree"
{% endif %}
		sudo mkdir -p /opt/parallelcluster/shared
		sudo touch /opt/parallelcluster/shared/staging_tree_pulled
	else
		echo "WARNING: could not pull the staging tree from s3://{{ s3_bucketname }}/staging/"
	fi
fi

if [ "$NODE_TYPE" == "HeadNode" ]
then
	sudo mkdir -p /opt/parallelcluster/shared
	sudo touch /opt/parallelcluster/shared/custom_action_done
fi

{% if enable_slurm_accounting == 'true' %}
# Slurm accounting: a local MariaDB so sacct reports job history.
#
# Head node only -- slurmdbd runs there and the database is reached over
# localhost, never the network.
#
# Warnings here go to STDOUT, not stderr. cfn-init captures stdout only --
# node stderr reaches no stream at all -- so a warning written to stderr
# is invisible to the one person it is for. Confirmed on `acctproof4`,
# where the tuning file silently failed to apply and the guard that
# detected it wrote three lines nobody could read, while an echo from the
# same script milliseconds later is in CloudWatch. The deferred unit below
# keeps `>&2`: it runs under systemd, where stderr reaches the journal.
#
# EVERY STEP HERE IS NON-FATAL, and that is the whole design. Once
# slurm.conf names an accounting host, slurmctld blocks indefinitely when
# that host does not answer -- observed live: slurmdbd died and `sinfo`
# hung until slurm.conf was restored. So a failure anywhere below must
# leave the cluster exactly as it would have been without the feature,
# rather than half-configured. slurm.conf is touched only after slurmdbd
# is confirmed listening, and is rolled back if slurmctld does not come
# back answering.
if [ "$NODE_TYPE" == "HeadNode" ]
then
	_acct_ok=1
	echo "Slurm accounting: installing MariaDB..."
{% if 'ubuntu' in base_os %}
	sudo DEBIAN_FRONTEND=noninteractive apt-get -y install mariadb-server \
		|| { echo "WARNING: MariaDB install failed; Slurm accounting is OFF"; _acct_ok=0; }
{% else %}
	sudo dnf -y install mariadb105-server \
		|| sudo dnf -y install mariadb-server \
		|| { echo "WARNING: MariaDB install failed; Slurm accounting is OFF"; _acct_ok=0; }
{% endif %}

	if [ "$_acct_ok" -eq 1 ]
	then
		# Sizing. Slurm's own guidance is 5-50% of memory and at least
		# 4 GiB for the buffer pool, with the redo log at 25% of it --
		# but that is sizing for a *dedicated* SQL server. This one is
		# co-resident with slurmctld on a head node, holds a single
		# cluster, and is purged at one month, so it is scaled to the
		# node and bounded at both ends:
		#
		#   pool = 10% of RAM, floored at 128M, capped at 4096M
		#   log  = 25% of pool, capped at 256M
		#
		# The pool cap is Slurm's own 4 GiB minimum. The log cap is
		# ours: 25% of a 4096M pool is a 1024M redo log, preallocated
		# on disk and replayed on crash recovery, for a database
		# measured at ~97 MB of data. 256M is still 2.6x MariaDB's own
		# 96M default.
		#
		# The pool floor matters more than the ceiling: Slurm warns
		# that too small a pool causes trouble when purging records or
		# upgrading the schema, which are exactly the operations that
		# touch everything at once.
		# "auto" derives from RAM (the default); an operator override is an
		# absolute value in MB, threaded from slurm_accounting_*_mb, for a
		# large or long-retention database that outgrows the derived ceiling.
		# The override is validated as a positive integer at build time.
		_mem_mb="$(awk '/^MemTotal:/{print int($2/1024)}' /proc/meminfo)"
{% if slurm_accounting_buffer_pool_mb == 'auto' %}
		_pool_mb=$(( _mem_mb / 10 ))
		if [ "$_pool_mb" -lt 128 ]; then _pool_mb=128; fi
		if [ "$_pool_mb" -gt 4096 ]; then _pool_mb=4096; fi
{% else %}
		_pool_mb={{ slurm_accounting_buffer_pool_mb }}
		# Clamp an explicit override to 80% of RAM. A buffer pool larger than
		# physical RAM aborts InnoDB at startup ("Unknown/unsupported storage
		# engine: InnoDB"), and the non-fatal latch then leaves accounting
		# silently OFF -- confirmed on a c8g.large (3.8G) head node where an
		# 8192M override did exactly that. RAM is unknown at build time, so
		# this is the only place the ceiling can be enforced; the auto branch
		# already caps this way. An override may raise the pool, never past
		# what will start.
		_pool_cap=$(( _mem_mb * 80 / 100 ))
		if [ "$_pool_mb" -gt "$_pool_cap" ]
		then
			echo "WARNING: slurm_accounting_buffer_pool_mb=${_pool_mb} exceeds 80% of ${_mem_mb}M RAM; clamping to ${_pool_cap}M so MariaDB can start"
			_pool_mb="$_pool_cap"
		fi
{% endif %}
{% if slurm_accounting_log_file_mb == 'auto' %}
		_log_mb=$(( _pool_mb / 4 ))
		if [ "$_log_mb" -gt 256 ]; then _log_mb=256; fi
{% else %}
		_log_mb={{ slurm_accounting_log_file_mb }}
{% endif %}

		# Where the server reads config from is read out of the server's
		# own config, never guessed. This shipped as `mkdir -p` of both
		# candidate directories followed by `if [ ! -d <debian one> ]`,
		# which can never be true because the mkdir just created it -- so
		# on AL2023, whose MariaDB reads /etc/my.cnf.d, every value in the
		# file below was silently ignored and the server ran on stock
		# defaults including innodb_lock_wait_timeout=50, which Slurm
		# explicitly requires to be 900. Confirmed on a live AL2023 head
		# node: `!includedir /etc/my.cnf.d`.
		_acct_cnf=""
		for _acct_mycnf in /etc/my.cnf /etc/mysql/my.cnf /etc/mysql/mariadb.cnf
		do
			[ -f "$_acct_mycnf" ] || continue
			_acct_dir="$(awk '/^!includedir/{print $2}' "$_acct_mycnf" | tail -1)"
			if [ -n "$_acct_dir" ] && [ -d "${_acct_dir%/}" ]
			then
				_acct_cnf="${_acct_dir%/}/99-slurm-acct.cnf"
				break
			fi
		done
		if [ -z "$_acct_cnf" ]
		then
			# No !includedir anywhere: fall back to whichever directory the
			# package actually created, testing before creating anything.
			if [ -d /etc/my.cnf.d ]; then _acct_cnf=/etc/my.cnf.d/99-slurm-acct.cnf
			elif [ -d /etc/mysql/mariadb.conf.d ]; then _acct_cnf=/etc/mysql/mariadb.conf.d/99-slurm-acct.cnf
			else _acct_cnf=""; fi
		fi
		if [ -z "$_acct_cnf" ]
		then
			echo "WARNING: found no MariaDB config directory; the server will"
			echo "  run on stock defaults. Slurm accounting will still work."
		fi
		if [ -n "$_acct_cnf" ]; then sudo tee "$_acct_cnf" >/dev/null <<ACCTCNF
[mysqld]
# performance_schema instruments a workload nobody here will profile and
# is worth several hundred MB on its own.
performance_schema = OFF

innodb_buffer_pool_size = ${_pool_mb}M
innodb_log_file_size    = ${_log_mb}M
innodb_flush_method     = O_DIRECT

# Slurm requires both of these by name. The rollup can hold locks well
# past the 50s default on a busy cluster; and with snapshot isolation ON,
# a concurrent write makes a locking read fail with ER_CHECKREAD, which
# slurmdbd cannot recover from -- it stops. The loose- prefix is required
# because MariaDB refuses to start on an unknown option and this variable
# does not exist before 10.6.18 / 10.11.8.
innodb_lock_wait_timeout        = 900
loose-innodb_snapshot_isolation = OFF
max_allowed_packet              = 16M

# slurmdbd opens a handful of connections. The default 151 pre-allocates
# per-thread buffers for connections that will never arrive.
max_connections   = 24
thread_cache_size = 8
table_open_cache  = 128

# Per-connection buffers are allocated per client, so the defaults
# multiply. Slurm's queries are small.
sort_buffer_size    = 256K
read_buffer_size    = 128K
join_buffer_size    = 256K
tmp_table_size      = 16M
max_heap_table_size = 16M

# MyISAM is effectively unused by Slurm; do not reserve for it.
key_buffer_size = 8M

# No replication and no point-in-time recovery: this database dies with
# the head node by design, and the binary log is pure write amplification.
skip-log-bin

# slurmdbd is on this node. Not listening is stronger than a firewall rule.
bind-address = 127.0.0.1
ACCTCNF
		fi

		# restart, not "enable --now". Installing mariadb-server starts
		# the service from its own postinst, so by the time the config
		# above is written the server is already up and `enable --now`
		# is a no-op against it -- the file is read at startup and
		# startup already happened. Measured on a live head node: every
		# value in this file was ignored, and the two that appeared to
		# have taken effect were coincidences where the setting matched
		# the stock default.
		sudo systemctl enable mariadb >/dev/null 2>&1 || true
		sudo systemctl restart mariadb \
			|| { echo "WARNING: MariaDB did not start; Slurm accounting is OFF"; _acct_ok=0; }
	fi

	if [ "$_acct_ok" -eq 1 ]
	then
		# Read the settings back. "The file exists" is not evidence it was
		# applied -- see the restart comment above, and the AL2023 build
		# where the file landed in a directory nothing reads.
		#
		# Checked on innodb_lock_wait_timeout, NOT the buffer pool. MariaDB
		# rounds the pool up to its own granularity: 767M was applied as
		# 768M on a live AL2023 node, so an exact comparison there reports
		# failure on a build that worked. A guard that cries wolf on every
		# build is worse than no guard at all, because this is the one that
		# catches a real defect. The lock timeout is an exact integer the
		# server never rounds, its stock default (50) always differs from
		# ours, and it is the one value Slurm itself requires to be 900.
		_acct_eff="$(sudo mariadb -N -B -e 'select @@innodb_lock_wait_timeout;' 2>/dev/null || echo 0)"
		if [ "$_acct_eff" != "900" ]
		then
			echo "WARNING: MariaDB did not read ${_acct_cnf:-the tuning file}"
			echo "  (innodb_lock_wait_timeout is ${_acct_eff}, expected 900)."
			echo "  Accounting will still work, but on stock defaults -- including"
			echo "  a lock timeout Slurm requires to be 900."
		fi
	fi

	if [ "$_acct_ok" -eq 1 ]
	then
		_acct_pw="$(openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24)"
		sudo mariadb -e "CREATE DATABASE IF NOT EXISTS slurm_acct_db;" \
			&& sudo mariadb -e "CREATE USER IF NOT EXISTS 'slurm'@'localhost' IDENTIFIED BY '${_acct_pw}';" \
			&& sudo mariadb -e "GRANT ALL ON slurm_acct_db.* TO 'slurm'@'localhost'; FLUSH PRIVILEGES;" \
			|| { echo "WARNING: could not create the accounting database; Slurm accounting is OFF"; _acct_ok=0; }
	fi

	if [ "$_acct_ok" -eq 1 ]
	then
		# SlurmUser comes from slurm.conf's own SlurmUser= line, never
		# from the ownership of the file. It shipped as `stat -c %U`,
		# which returns root because root owns slurm.conf, while
		# slurmctld actually runs as `slurm` -- so slurmdbd started
		# happily and slurmctld was then refused by it with "Your user
		# doesn't have privilege to perform this action", leaving a
		# cluster that built green with a dead scheduler.
		_slurm_user="$(awk -F= '/^SlurmUser=/{print $2}' /opt/slurm/etc/slurm.conf)"
		if [ -z "$_slurm_user" ]; then _slurm_user=slurm; fi

		sudo tee /opt/slurm/etc/slurmdbd.conf >/dev/null <<SLURMDBD
AuthType=auth/munge
DbdHost=localhost
DbdPort=6819
SlurmUser=${_slurm_user}

StorageType=accounting_storage/mysql
StorageHost=localhost
StoragePort=3306
StorageUser=slurm
StoragePass=${_acct_pw}
StorageLoc=slurm_acct_db

# One month of job detail, a year of the rolled-up usage that reports are
# built from. Every Purge* setting defaults to never, so a database with
# no purge policy grows without bound -- on a head node whose root volume
# is sized for an operating system, not a warehouse. Deliberately no
# ArchiveDir: archiving defaults to /tmp, and an archive nobody collects
# before the head node is torn down is not a backup.
PurgeEventAfter=1month
PurgeJobAfter=1month
PurgeResvAfter=1month
PurgeStepAfter=1month
PurgeSuspendAfter=1month
PurgeTXNAfter=12months
PurgeUsageAfter=12months

LogFile=/var/log/slurmdbd.log
PidFile=/var/run/slurmdbd.pid
SLURMDBD
		sudo chown "${_slurm_user}" /opt/slurm/etc/slurmdbd.conf
		sudo chmod 600 /opt/slurm/etc/slurmdbd.conf
		sudo touch /var/log/slurmdbd.log
		sudo chown "${_slurm_user}" /var/log/slurmdbd.log

		# A managed unit, ordered after MariaDB. Started by hand it dies
		# with whatever session started it, and slurmctld then blocks on
		# a database that is not there. No User= directive, matching
		# PCluster's own slurmctld unit: slurmdbd is started as root and
		# drops to SlurmUser itself after reading its config.
		sudo tee /etc/systemd/system/slurmdbd.service >/dev/null <<'SLURMDBDUNIT'
[Unit]
Description=Slurm DBD accounting daemon
After=network-online.target mariadb.service munge.service
Wants=network-online.target
Requires=mariadb.service

[Service]
Type=simple
ExecStart=/opt/slurm/sbin/slurmdbd -D
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
SLURMDBDUNIT
		sudo systemctl daemon-reload
		sudo systemctl enable --now slurmdbd \
			|| { echo "WARNING: slurmdbd did not start; Slurm accounting is OFF"; _acct_ok=0; }
	fi

	# slurm.conf is NOT edited here, and slurmctld is NOT restarted here.
	#
	# postinstall runs as OnNodeConfigured, which is *inside* PCluster's own
	# bootstrap -- aws-parallelcluster-slurm::finalize_head_node has not run
	# yet, and it waits for clustermgtd to write its heartbeat. Restarting
	# slurmctld from here tore the scheduler out from under that recipe and
	# failed the whole build: "cat: /opt/slurm/etc/pcluster/.slurm_plugin/
	# clustermgtd_heartbeat: No such file or directory". The accounting
	# block had *succeeded*; it was its success at the wrong moment that
	# broke the cluster.
	#
	# Same class as the GPU NVMe block, which must skip devices the cookbook
	# already claimed. So this defers: a one-shot unit waits for the
	# heartbeat -- the cookbook's own signal that it is finished -- and only
	# then edits slurm.conf and restarts slurmctld.
	if [ "$_acct_ok" -eq 1 ]
	then
		sudo tee /usr/local/sbin/pcm-enable-slurm-acct >/dev/null <<'ACCTDEFER'
#!/bin/bash
# Enable Slurm accounting once PCluster's own bootstrap has finished.
set -uo pipefail

CONF=/opt/slurm/etc/slurm.conf
BACKUP=/opt/slurm/etc/slurm.conf.pcm-preacct
HEARTBEAT=/opt/slurm/etc/pcluster/.slurm_plugin/clustermgtd_heartbeat

for _ in $(seq 1 120); do
    [ -f "$HEARTBEAT" ] && break
    sleep 10
done
if [ ! -f "$HEARTBEAT" ]; then
    echo "clustermgtd never wrote its heartbeat; leaving slurm.conf alone" >&2
    exit 0
fi
if ! ss -lnt 2>/dev/null | grep -q ':6819 '; then
    echo "slurmdbd is not listening; leaving slurm.conf alone" >&2
    exit 0
fi

cp "$CONF" "$BACKUP"

python3 - "$CONF" <<'ACCTCONF'
import re, sys
p = sys.argv[1]
s = open(p).read()
keys = ("AccountingStorageType", "AccountingStorageHost", "AccountingStoragePort",
        "JobAcctGatherType", "JobAcctGatherFrequency")
for k in keys:
    s = re.sub(rf"(?m)^{k}=.*$\n?", "", s)
open(p, "w").write(s.rstrip("\n") + "\n" + "\n".join([
    "AccountingStorageType=accounting_storage/slurmdbd",
    "AccountingStorageHost=localhost",
    "AccountingStoragePort=6819",
    "JobAcctGatherType=jobacct_gather/linux",
    "JobAcctGatherFrequency=30",
]) + "\n")
ACCTCONF

# Roll back on anything short of a scheduler that answers. A cluster
# without accounting is a working cluster; a cluster whose slurmctld
# cannot reach slurmdbd is one where every Slurm command hangs.
_rollback() {
    echo "$1 -- rolling slurm.conf back" >&2
    cp "$BACKUP" "$CONF"
    systemctl restart slurmctld
    exit 0
}

systemctl restart slurmctld || _rollback "slurmctld would not restart"
sleep 8
systemctl is-active --quiet slurmctld || _rollback "slurmctld is not active"
timeout 30 /opt/slurm/bin/sinfo -h >/dev/null 2>&1 \
    || _rollback "slurmctld is up but not answering"

# No `sacctmgr add cluster` here. Slurm 20.02 and later register the
# cluster themselves when slurmctld starts against slurmdbd, and adding
# it by hand first is what produced "there's no TRES from it" on a live
# build -- a row created before slurmctld had reported its resources.
SU="$(awk -F= '/^SlurmUser=/{print $2}' "$CONF")"
[ -n "$SU" ] || SU=slurm
CN="$(awk -F= '/^ClusterName=/{print $2}' "$CONF")"

_sacctmgr() { runuser -u "$SU" -- /opt/slurm/bin/sacctmgr "$@"; }

for _ in $(seq 1 12); do
    _sacctmgr -n list cluster format=cluster 2>/dev/null | grep -qw "$CN" && break
    sleep 5
done

_sacctmgr -i add account "$CN" Description="$CN" Organization="$CN" >/dev/null 2>&1 || true

# The login user always; the cluster owner only when it is a real account
# on this node. AdminLevel=Admin so either can read every user's jobs --
# without it sacct shows only the caller's own.
for u in {{ ec2_user }} {{ cluster_owner }}; do
    id "$u" >/dev/null 2>&1 || continue
    _sacctmgr -i add user "$u" Account="$CN" AdminLevel=Admin >/dev/null 2>&1 || true
done

echo "Slurm accounting enabled for $CN"
ACCTDEFER
		sudo chmod 755 /usr/local/sbin/pcm-enable-slurm-acct
		sudo tee /etc/systemd/system/pcm-slurm-acct.service >/dev/null <<'ACCTUNIT'
[Unit]
Description=Enable Slurm accounting after the ParallelCluster bootstrap
After=network-online.target mariadb.service slurmdbd.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/pcm-enable-slurm-acct
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
ACCTUNIT
		sudo systemctl daemon-reload
		sudo systemctl enable pcm-slurm-acct.service >/dev/null 2>&1 || true
		# --no-block: this must not hold the bootstrap open. It waits for a
		# heartbeat that only appears after postinstall returns.
		sudo systemctl start --no-block pcm-slurm-acct.service \
			|| echo "WARNING: could not schedule the accounting enable step"
		echo "Slurm accounting: MariaDB (pool ${_pool_mb}M, log ${_log_mb}M) and"
		echo "  slurmdbd are up; slurm.conf will be updated once the cluster"
		echo "  bootstrap finishes."
	fi
	unset _acct_pw
fi
{% endif %}

exit 0
