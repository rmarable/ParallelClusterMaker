{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "MCPRouterInvokeHandlers",
            "Effect": "Allow",
            "Action": "lambda:InvokeFunction",
            "Resource": [
                "arn:aws:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:pclustermaker-mcp-read-only",
                "arn:aws:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:pclustermaker-mcp-fleet-toggle",
                "arn:aws:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:pclustermaker-mcp-stack-mutation",
                "arn:aws:lambda:<AWS_REGION>:<AWS_ACCOUNT_ID>:function:pclustermaker-mcp-stack-mutation-node"
            ]
        }
    ]
}
