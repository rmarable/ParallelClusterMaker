#!/bin/bash
set -euo pipefail
################################################################################
# Name:         monitoring-post-install-wrapper.{{ cluster_name }}.sh
# Generated by: ParallelClusterMaker on {{ DEPLOYMENT_DATE }}
# Purpose:      Install aws-parallelcluster-monitoring {{ monitoring_version }}
#               from S3 — no GitHub calls at node boot time.
#
# We bypass the upstream post-install.sh because it always re-downloads the
# tarball from GitHub. Instead we extract our S3-staged copy directly to
# MONITORING_HOME and invoke installer/install.sh, which is fully self-
# contained once the source tree is present on disk.
################################################################################

# A profile fragment is written for an interactive shell and survives none of
# these options reliably: /etc/profile.d may reference an unset variable (fatal
# under `set -u`), and AL2023's debuginfod.sh assigns from a pipeline whose first
# stage fails because /etc/debuginfod/ does not exist (fatal under `pipefail`).
# Suspend all three, and do not narrow this back to `set +u`.
set +euo pipefail
source /etc/profile
set -euo pipefail

# A web server on the head node holds port 80 and blocks the monitoring nginx
# container. Ubuntu PCluster head nodes ship apache2; the RPM-based equivalent is
# named httpd. Both are checked because the unit name is the only difference, and
# is-active on an absent unit is a no-op.
for _httpd in apache2 httpd; do
    if systemctl is-active --quiet "$_httpd" 2>/dev/null; then
        systemctl stop "$_httpd"
        systemctl disable "$_httpd"
    fi
done

MONITORING_VERSION="{{ monitoring_version }}"
TARBALL="aws-parallelcluster-monitoring-${MONITORING_VERSION}.tar.gz"
S3_URI="s3://{{ s3_bucketname }}/{{ s3_script_path }}/${TARBALL}"
LOG="/var/log/parallelcluster-monitoring-install.log"

exec > >(tee -a "$LOG") 2>&1

echo "[$(date)] Starting aws-parallelcluster-monitoring ${MONITORING_VERSION} install"

# Derive MONITORING_HOME from cfnconfig (same logic as installer/platform/parallelcluster.sh).
# shellcheck disable=SC1091
source /etc/parallelcluster/cfnconfig
CLUSTER_USER="${cfn_cluster_user}"
MONITORING_HOME="/home/${CLUSTER_USER}/aws-parallelcluster-monitoring"

# MONITORING_HOME lives under /home, which every compute node NFS-mounts from the
# head node, and upstream's installer/install.sh computes that path itself with no
# override -- so only the head node may write the tree.  Two compute nodes running
# this block against the same NFS directory destroy each other: on 2026-07-27 two
# c5.2xlarge nodes 92ms apart failed OnNodeConfigured with rc=127 (install.sh
# deleted by the other node's `rm -rf` between this tar and the bash below) and
# rc=1, counting 2 toward the partition's 10-failure protected-mode threshold.
#
# Compute nodes need the tree only to exist and be readable: compute.yml mounts
# nothing from it, and the GPU path reads dcgm/counters.csv and substitutes
# __MONITORING_DIR__ in compose/compute.gpu.yml.  Neither needs to create it.
#
# Ordering makes the read safe.  cfn-init runs the head node's steps in sequence:
# runpostinstall (which contains this wrapper) completes before the chef finalize
# step that starts clustermgtd, and clustermgtd is what launches compute nodes.
if [ "${cfn_node_type}" == "HeadNode" ]
then
	# Instance role already has s3:GetObject on this bucket.
	aws s3 cp "$S3_URI" "/tmp/${TARBALL}" --region {{ region }}

	# Extract directly to MONITORING_HOME — no intermediate INSTALL_DIR needed.
	rm -rf "$MONITORING_HOME"
	mkdir -p "$MONITORING_HOME"
	tar -xzf "/tmp/${TARBALL}" --strip-components=1 -C "$MONITORING_HOME"
	rm -f "/tmp/${TARBALL}"

	chown -R "${CLUSTER_USER}:${CLUSTER_USER}" "$MONITORING_HOME"
elif [ "${cfn_node_type}" == "LoginNode" ]
then
	# Upstream's installer handles two node types and no more -- its own
	# header says "ParallelCluster HeadNode and ComputeFleet nodes", and its
	# `case "${PLATFORM_NODE_TYPE}"` has arms for exactly those.  A login
	# node falls through `verify_docker` and then matches nothing, so the
	# run fails; this wrapper exits with the installer's status, so that
	# failure became the custom action's, the node was marked unhealthy, and
	# its Auto Scaling Group replaced it -- forever.  Observed on a live
	# build: three login nodes launched and abandoned on Heartbeat Timeout
	# over 45 minutes, with the stack never leaving CREATE_IN_PROGRESS.
	#
	# So a login node does nothing here.  Grafana runs on the head node and
	# operators reach it through grafana_tunnel; there is no login-node half
	# of this stack to install.  Exiting 0 also retires the bounded poll for
	# MONITORING_HOME that used to live here: that existed only to let the
	# install proceed once the head node caught up, and nothing is installed
	# now, so waiting buys nothing and cost every login node up to 300s of
	# boot time.
	echo "LoginNode: upstream's monitoring installer supports HeadNode and"
	echo "           ComputeFleet only, so there is nothing to install here."
	exit 0
elif [ ! -r "$MONITORING_HOME/installer/install.sh" ]
then
	echo "ERROR: $MONITORING_HOME/installer/install.sh is absent or unreadable;"
	echo "       the head node's monitoring install did not complete"
	exit 1
fi
{% if stage_docker_compose == 'true' %}

# Amazon Linux 2023 does not package docker-compose-plugin, so upstream's
# installer/os/alinux2023.sh curls the plugin binary straight from github.com --
# no checksum, and unreachable from a private subnet, where it would fail the node
# outright.  The build staged a checksummed copy to S3; install it from there and
# delete upstream's curl so it is never attempted.
#
# This runs on EVERY node, not just the head node: the plugin lives in
# /usr/libexec/docker on local disk, and install.sh calls verify_docker (which
# runs `docker compose version`) before it branches on node type, so a compute
# node without the plugin dies there.  Pre-placing the file alone is not enough --
# upstream's curl is unconditional and would overwrite it, then fail on a private
# subnet -- which is why the patch below removes it rather than relying on ordering.
COMPOSE_PLUGIN_DIR="/usr/libexec/docker/cli-plugins"
COMPOSE_S3_URI="s3://{{ s3_bucketname }}/{{ s3_script_path }}/{{ docker_compose_s3_dest }}"
install -d -m 0755 "$COMPOSE_PLUGIN_DIR"
aws s3 cp "$COMPOSE_S3_URI" "$COMPOSE_PLUGIN_DIR/docker-compose" --region {{ region }}
chmod 0755 "$COMPOSE_PLUGIN_DIR/docker-compose"

# Only the head node owns $MONITORING_HOME (see above), so only it may patch the
# tree; a compute node reads the already-patched copy over NFS.
#
# Both awk programs below accumulate line continuations and match whole logical
# commands, not lines.  Upstream's fetch is currently a two-line `curl ... \` with
# the -o on the second line, but matching that shape literally is brittle in the
# one direction that matters: a reordered `-o`, a third continuation, or a switch
# to wget all leave a partial delete behind -- and a syntactically broken
# alinux2023.sh is a dead node, while a surviving download silently overwrites the
# binary we staged.  The predicate is therefore "a downloader invocation that
# mentions docker-compose", which is shape-independent and cannot match anything
# else in that file (its own `install -d` and `chmod +x` name the path but fork no
# downloader).
#
# awk rather than `sed -i`: both in-place editing and the `,+N` address form are
# GNU extensions, and the toolkit's tests run on macOS as well as Linux.
#
# This is idempotent, and must stay so -- the head node's postinstall can be
# re-run by hand.  Deleting whole logical commands is what makes it so; a
# line-offset delete eats two more lines on every pass.
if [ "${cfn_node_type}" == "HeadNode" ]
then
	_al2023_installer="$MONITORING_HOME/installer/os/alinux2023.sh"
	_compose_fetch='{ _cmd = _cmd $0 "\n" } /\\$/ { next }'

	awk "$_compose_fetch"'
		{ if (_cmd !~ /curl|wget/ || _cmd !~ /docker-compose/) printf "%s", _cmd; _cmd = "" }
		END { printf "%s", _cmd }
	' "$_al2023_installer" > "$_al2023_installer.patched"
	if ! cmp -s "$_al2023_installer.patched" "$_al2023_installer"
	then
		echo "Removed upstream's compose download from $(basename "$_al2023_installer")"
	fi
	mv "$_al2023_installer.patched" "$_al2023_installer"

	# The patch is verified rather than trusted.  If upstream's fetch stops
	# matching the predicate above, the awk silently changes nothing, the staged
	# binary is overwritten at install time, and a private-subnet cluster fails on
	# a network error twenty minutes in with nothing pointing at the cause.  Fail
	# here instead, by name.
	if ! awk "$_compose_fetch"'
		{ if (_cmd ~ /curl|wget/ && _cmd ~ /docker-compose/) _bad = 1; _cmd = "" }
		END { if (_cmd ~ /curl|wget/ && _cmd ~ /docker-compose/) _bad = 1; exit _bad }
	' "$_al2023_installer"
	then
		echo "ERROR: a compose download survived the patch in"
		echo "       $_al2023_installer -- its shape changed in monitoring"
		echo "       {{ monitoring_version }} and the awk above no longer matches."
		exit 1
	fi
fi
{% endif %}

# Run the platform-aware installer directly (skipping post-install.sh's GitHub fetch).
set +e
bash -x "$MONITORING_HOME/installer/install.sh" 2>&1 | tee -a "$LOG"
rc=${PIPESTATUS[0]}
set -e

if [[ ${rc} -ne 0 ]]; then
    echo "============================================================="
    echo "monitoring install FAILED with exit ${rc}"
    echo "last 80 lines of ${LOG}:"
    echo "============================================================="
    tail -n 80 "$LOG" || true
fi

exit "${rc}"
