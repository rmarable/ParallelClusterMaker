################################################################################
# Name:         {{ cluster_name }}.yml
# Author:       Rodney Marable <rodney.marable@gmail.com>
# Deployed On:  {{ DEPLOYMENT_DATE }}
# Purpose:      ParallelCluster configuration for cluster "{{ cluster_name }}"
# Notes:        Automatically generated by ParallelClusterMaker
################################################################################

# Metadata tags for cluster identification

cluster_name: "{{ cluster_name }}"
cluster_owner: "{{ cluster_owner }}"
turbot_account: "{{ turbot_account }}"
ssh_secret_name: "{{ ssh_secret_name }}"
cluster_owner_department: "{{ cluster_owner_department }}"
cluster_owner_email: "{{ cluster_owner_email }}"
cluster_serial_number: "{{ cluster_serial_number }}"
cluster_serial_number_file: "{{ cluster_serial_number_file }}"
cluster_serial_datestamp: "{{ cluster_serial_datestamp }}"
project_id: "{{ project_id }}"
prod_level: "{{ prod_level }}"
DEPLOYMENT_DATE: "{{ DEPLOYMENT_DATE }}"

# HeadNode and Compute instance definitions

base_os: "{{ base_os }}"
pcluster_os: "{{ pcluster_os }}"
custom_ami: "{{ custom_ami }}"
hyperthreading: "{{ hyperthreading }}"
headnode_instance_type: "{{ headnode_instance_type }}"
headnode_root_volume_size: {{ headnode_root_volume_size }}
headnode_root_volume_type: "{{ headnode_root_volume_type }}"
headnode_root_volume_iops: {{ headnode_root_volume_iops }}
headnode_root_volume_throughput: {{ headnode_root_volume_throughput }}
enable_loginnode: "{{ enable_loginnode }}"
loginnode_instance_type: "{{ loginnode_instance_type }}"
loginnode_count: {{ loginnode_count }}
compute_instance_type: "{{ compute_instance_type }}"
cpu_instance_types: {{ cpu_instance_types | tojson }}
gpu_instance_type: "{{ gpu_instance_type }}"
gpu_instance_types: {{ gpu_instance_types | tojson }}
compute_root_volume_size: {{ compute_root_volume_size }}
compute_root_volume_type: "{{ compute_root_volume_type }}"
compute_root_volume_iops: {{ compute_root_volume_iops }}
compute_root_volume_throughput: {{ compute_root_volume_throughput }}
gpu_root_volume_size: {{ gpu_root_volume_size }}
gpu_root_volume_type: "{{ gpu_root_volume_type }}"
gpu_root_volume_iops: {{ gpu_root_volume_iops }}
gpu_root_volume_throughput: {{ gpu_root_volume_throughput }}

# AWS networking parameters
#
# WARNING: Subnet and VPC values below were either explicitly provided or
# auto-discovered by the toolkit. Auto-discovery picks the first subnet
# returned by EC2 in each AZ, which is non-deterministic when multiple
# subnets exist. Verify these values are correct before deploying to
# production. Use --headnode_subnet_id and --compute_subnet_ids to
# specify network resources explicitly.

aws_account_id: "{{ aws_account_id }}"
region: "{{ region }}"
az: "{{ az }}"
vpc_id: "{{ vpc_id }}"
vpc_cidr: "{{ vpc_cidr }}"
vpc_name: "{{ vpc_name }}"
subnet_id: "{{ subnet_id }}"
loginnode_subnet_id: "{{ loginnode_subnet_id }}"
compute_az_list: "{{ compute_az_list | join(',') }}"
compute_subnet_ids: "{{ compute_subnet_ids | join(',') }}"
use_private_compute_subnet: "{{ use_private_compute_subnet | lower }}"
gpu_subnet_ids: "{{ gpu_subnet_ids | join(',') }}"
use_private_gpu_subnet: "{{ use_private_gpu_subnet | lower }}"

# Elastic Fabric Adapter (EFA) parameters

enable_efa: "{{ enable_efa }}"
enable_efa_gdr: "{{ enable_efa_gdr }}"

# Queue enable flags (derived — not user-settable)

enable_cpu_queue: "{{ enable_cpu_queue }}"
enable_gpu_queue: "{{ enable_gpu_queue }}"
enable_gpu: "{{ enable_gpu }}"
gpu_ranks_per_node: {{ gpu_ranks_per_node }}
cpu_ranks_per_node: {{ cpu_ranks_per_node }}
gpu_vcpus_per_node: {{ gpu_vcpus_per_node }}

# EC2 instance parameters

ec2_keypair: "{{ cluster_serial_number }}_{{ region }}"
ec2_user: "{{ ec2_user }}"
ec2_user_home: "{{ ec2_user_home }}"
ec2_user_src: "{{ ec2_user_home }}/src"
ec2_iam_policy: "{{ ec2_iam_policy }}"
ec2_iam_role: "{{ ec2_iam_role }}"

# Critical directory paths

cluster_rootdir: "{{ local_workingdir }}"
cluster_data_dir: "{{ cluster_rootdir }}/active_clusters/{{ cluster_name }}"
cluster_template_dir: "{{ cluster_rootdir }}/templates"
stage_dir: "/tmp/_ParallelClusterMaker_stage/{{ cluster_serial_number }}"

# SNS templates

sns_build_summary_report_src: "{{ cluster_template_dir }}/sns_build_summary_report.j2"
sns_build_summary_report_dest: "{{ cluster_data_dir }}/sns_build_summary.{{ cluster_name }}.txt"
sns_destruction_summary_report_src: "{{ cluster_template_dir }}/sns_destruction_summary_report.j2"

# User and environment configuration

ANSIBLE_VERSION: "{{ ANSIBLE_VERSION }}"
ssh_keypair: "{{ cluster_data_dir }}/{{ ec2_keypair }}.pem"
ssh_known_hosts: "{{ ssh_known_hosts }}"

# Cluster stack and autoscaling configuration

cluster_config_dest: config.{{ cluster_name }}
cluster_config_template: "{{ cluster_data_dir }}/config.{{ cluster_name }}"
cluster_config_template_orig: "{{ cluster_template_dir }}/config.pcluster.j2"
cluster_type: "{{ cluster_type }}"
placement_group: "{{ placement_group }}"
scaledown_idletime: {{ scaledown_idletime }}

# Scheduler parameters

scheduler: "{{ scheduler }}"
initial_cpu_queue_size: {{ initial_cpu_queue_size }}
maintain_cpu_initial_size: "{{ maintain_cpu_initial_size }}"
max_cpu_queue_size: {{ max_cpu_queue_size }}
initial_gpu_queue_size: {{ initial_gpu_queue_size }}
maintain_gpu_initial_size: "{{ maintain_gpu_initial_size }}"
max_gpu_queue_size: {{ max_gpu_queue_size }}

# Stack creation poll timeout (retries × 60 s each; default = 60 → 60 min)
pcluster_create_timeout: {{ pcluster_create_timeout }}

# S3 bucket-related configuration

s3_bucketname: "{{ s3_bucketname }}"
results_bucketname: "{{ results_bucketname }}"
s3_script_path: cluster_scripts/{{ prod_level }}
s3_cluster_data_dir: "active_clusters"

# Lambda stack termination function configuration


# ParallelCluster pre/post-deployment script configuration.
# Two distinct stages run on every node, in this order:
#   1. the toolkit's own rendered preinstall.j2 / postinstall.j2
#   2. the operator's hook named by --pre_install_script / --post_install_script
# Conflating the two is what left postinstall.j2 unrendered and unreferenced from
# the v3 migration until 2026-07-26.

pre_install_script: "{{ pre_install_script }}"
post_install_script: "{{ post_install_script }}"
preinstall_template_orig: "{{ cluster_template_dir }}/preinstall.j2"
preinstall_rendered: "{{ cluster_data_dir }}/preinstall.{{ cluster_name }}.sh"
preinstall_s3_dest: "preinstall.{{ cluster_name }}.sh"
postinstall_template_orig: "{{ cluster_template_dir }}/postinstall.j2"
postinstall_rendered: "{{ cluster_data_dir }}/postinstall.{{ cluster_name }}.sh"
postinstall_s3_dest: "postinstall.{{ cluster_name }}.sh"
user_preinstall_src: "{{ cluster_rootdir }}/{{ pre_install_script }}"
user_preinstall_s3_dest: "{{ pre_install_script.split('/')[-1] }}"
user_postinstall_src: "{{ cluster_rootdir }}/{{ post_install_script }}"
user_postinstall_s3_dest: "{{ post_install_script.split('/')[-1] }}"

# Monitoring configuration

enable_monitoring: "{{ enable_monitoring }}"
{% if enable_monitoring == 'true' %}
monitoring_version: "{{ monitoring_version }}"
monitoring_version_checksum: "{{ monitoring_version_checksum }}"
monitoring_s3_dest: "{{ monitoring_s3_dest }}"
monitoring_wrapper_src: "{{ cluster_template_dir }}/monitoring-post-install-wrapper.j2"
monitoring_wrapper_dest: "{{ cluster_data_dir }}/monitoring-post-install-wrapper.{{ cluster_name }}.sh"
grafana_tunnel_src: "{{ cluster_template_dir }}/grafana_tunnel.j2"
grafana_tunnel_dest: "{{ stage_dir }}/grafana_tunnel.{{ cluster_name }}.sh"
# The Docker Compose CLI plugin is staged to S3 only for the alinux2023 base_os
# values, which have no docker-compose-plugin package; the Ubuntu and RHEL arms
# install it from a signed distro repository and need none of this.
stage_docker_compose: "{{ stage_docker_compose }}"
{% if stage_docker_compose == 'true' %}
docker_compose_version: "{{ docker_compose_version }}"
docker_compose_arch: "{{ docker_compose_arch }}"
docker_compose_checksum: "{{ docker_compose_checksum }}"
docker_compose_s3_dest: "docker-compose-linux-{{ docker_compose_arch }}-{{ docker_compose_version }}"
docker_compose_local_dest: "{{ cluster_data_dir }}/docker-compose-linux-{{ docker_compose_arch }}-{{ docker_compose_version }}"
{% endif %}
{% endif %}

# HPC performance test configuration

enable_hpc_benchmarks: "{{ enable_hpc_benchmarks }}"

# HPC performance test directories

headnode_performance_dir_dest: "{{ ec2_user_home }}/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"
performance_rootdir: "{{ local_workingdir }}/hpc-benchmark"
performance_stage_dir: "{{ stage_dir }}/hpc-benchmark/{{ scheduler }}"

# EBS mount definitions

ebs_root: /shared
ebs_encryption: "{{ ebs_encryption }}"
ebs_performance_dir: "{{ ebs_root }}/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"
ebs_shared_dir: "{{ ebs_shared_dir }}"
ebs_shared_volume_size: {{ ebs_shared_volume_size }}
ebs_shared_volume_type: "{{ ebs_shared_volume_type }}"
ebs_shared_volume_iops: {{ ebs_shared_volume_iops }}
ebs_shared_volume_throughput: {{ ebs_shared_volume_throughput }}

head_node_bootstrap_timeout: {{ head_node_bootstrap_timeout }}

enable_efs: "{{ enable_efs }}"
enable_external_nfs: "{{ enable_external_nfs }}"
enable_fsx: "{{ enable_fsx }}"
enable_fsx_hydration: "{{ enable_fsx_hydration }}"

{% if enable_efs == 'true' %}
# EFS definitions

efs_root: /efs
efs_hpc_performance_dir: "{{ efs_root }}/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"
efs_pkg_dir: "{{ efs_root }}/pkg"
efs_encryption: "{{ efs_encryption }}"
efs_performance_mode: "{{ efs_performance_mode }}"
efs_throughput_mode: "{{ efs_throughput_mode }}"
{% endif %}

{% if enable_external_nfs == 'true' %}
# External NFS definitions

external_nfs_server: "{{ external_nfs_server }}"
external_nfs_server_root: /nfs
external_nfs_mount_list_template_orig: "{{ cluster_template_dir }}/external_nfs_mount_list.j2"
external_nfs_mount_list_template_src: "{{ cluster_data_dir }}/external_nfs_mount_list.{{ cluster_name }}.conf"
external_nfs_mount_list_template_dest: "external_nfs_mount_list.{{ cluster_name }}.conf"
external_nfs_pkg_dir: "/nfs/pkg"
external_nfs_hpc_performance_dir: "/nfs/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"
{% endif %}

{% if enable_fsx == 'true' %}
# FSx for Lustre (FSxL) definitions

fsx_root: /fsx
fsx_size: {{ fsx_size }}
fsx_hpc_performance_dir: "{{ fsx_root }}/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"
fsx_pkg_dir: "{{ fsx_root }}/pkg"
{% if enable_fsx_hydration == 'true' %}
fsx_chunk_size: {{ fsx_chunk_size }}
fsx_hydration_iam_policy: "{{ fsx_hydration_iam_policy }}"
fsx_s3_import_bucket: "{{ fsx_s3_import_bucket }}"
fsx_s3_import_path: "{{ fsx_s3_import_path }}"
fsx_s3_export_bucket: "{{ fsx_s3_export_bucket }}"
fsx_s3_export_path: "{{ fsx_s3_export_path }}"
{% endif %}
{% endif %}

# Vanilla shared EBS HPC performance definitions

ebs_hpc_performance_dir: "{{ ebs_shared_dir }}/hpc-benchmark/{{ cluster_name }}/{{ cluster_owner }}/{{ scheduler }}"

# Spack configuration

{% if enable_fsx == 'true' %}
pkg_dir: "{{ fsx_pkg_dir }}"
spack_root: "{{ fsx_pkg_dir }}/spack"
{% elif enable_efs == 'true' %}
pkg_dir: "{{ efs_pkg_dir }}"
spack_root: "{{ efs_pkg_dir }}/spack"
{% elif enable_external_nfs == 'true' %}
pkg_dir: /nfs/pkg
spack_root: /nfs/pkg/spack
{% else %}
pkg_dir: "{{ ebs_shared_dir }}/pkg"
spack_root: "{{ ebs_shared_dir }}/pkg/spack"
{% endif %}
