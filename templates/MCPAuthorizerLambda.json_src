{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "MCPAuthorizerVerifyClient",
            "Action": [
                "cognito-idp:DescribeUserPoolClient"
            ],
            "Effect": "Allow",
            "Resource": [
                "arn:aws:cognito-idp:<AWS_REGION>:<AWS_ACCOUNT_ID>:userpool/<MCP_USER_POOL_ID>"
            ]
        }
    ]
}
